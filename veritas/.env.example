# ---------- LLM (the critics + arbiter) ----------
# groq | openai | anthropic | ollama | offline
# "offline" = built-in heuristic critics, no API key needed (demo/testing only).
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Embeddings (RAG) ----------
# fastembed (local, free, ~130MB one-time download) | openai | hash (offline fallback)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---------- Pipeline tuning (all optional) ----------
RETRIEVAL_TOP_K=4
CLAIM_TOP_K=3
MAX_CLAIMS=8
SELFCHECK_SAMPLES=2
MAX_CONCURRENCY=4

# Critic weights used by the arbiter (renormalised automatically)
WEIGHT_ACCURACY=0.30
WEIGHT_GROUNDING=0.30
WEIGHT_COMPLETENESS=0.20
WEIGHT_CONSISTENCY=0.20
